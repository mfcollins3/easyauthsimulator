<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Generates the TypeScript SDK bindings for AddEasyAuthSimulator/WithUpstream/WithEntraId
         from their [AspireExport] annotations when a TypeScript AppHost references this project. -->
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>EasyAuthSimulator.Hosting</PackageId>
    <Version>0.1.0</Version>
    <Authors>Michael Collins</Authors>
    <Description>Aspire hosting integration (AddEasyAuthSimulator/WithUpstream/WithEntraId) that runs the EasyAuthSimulator container image — a local stand-in for Azure Container Apps' built-in authentication ("EasyAuth") — as part of an AppHost.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.5.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
