<Project Sdk="Aspire.AppHost.Sdk/13.5.4">

  <ItemGroup>
    <!-- Referenced only to call AddEasyAuthSimulator(); the simulator itself runs as a container
         (see AddContainer() in EasyAuthSimulatorResourceBuilderExtensions.cs), so it isn't an
         Aspire project resource. -->
    <ProjectReference Include="..\..\src\EasyAuthSimulator.Hosting\EasyAuthSimulator.Hosting.csproj" IsAspireProjectResource="false" />
    <ProjectReference Include="..\SampleApp\SampleApp.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>bcc95448-f5e6-4656-bbd0-8f8e653fe032</UserSecretsId>
  </PropertyGroup>

</Project>
